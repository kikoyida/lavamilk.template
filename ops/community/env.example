# Copy to the BaoTa compose .env; never commit real credentials.
MYSQL_DATABASE=lavamilk_community
MYSQL_USER=lavamilk
# Use long random URL-safe values. Existing database passwords must not be changed here alone.
MYSQL_PASSWORD=REPLACE_ON_SERVER
MYSQL_ROOT_PASSWORD=REPLACE_ON_SERVER
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional server token for public GitHub API rate limits.
PIG_GITHUB_TOKEN=
